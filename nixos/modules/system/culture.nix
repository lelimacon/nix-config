{
  ...
}:
{
  # Console keymap.
  console.keyMap = "fr";

  # Timezone.
  time.timeZone = "Asia/Hong_Kong";

  # Locale.
  i18n.defaultLocale = "en_US.UTF-8";
  i18n.extraLocaleSettings =
  {
    LANGUAGE = "en_US.UTF-8";
    LANG = "en_US.UTF-8";
    #LC_ALL = "en_US.UTF-8";
    LC_MESSAGES = "en_US.UTF-8";
    LC_TIME = "fr_FR.UTF-8";
  };
}
